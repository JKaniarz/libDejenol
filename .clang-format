# K&R style with tab indentation and a 132 column limit
BasedOnStyle: LLVM
Language: Cpp

# K&R braces: opening brace on the same line, "} else {" on one line
# Brace-less if statements stay on the same line as the condition
BreakBeforeBraces: Attach
AllowShortFunctionsOnASingleLine: InlineOnly
AllowShortIfStatementsOnASingleLine: Always
AllowShortLoopsOnASingleLine: false
AllowShortBlocksOnASingleLine: Never
AllowShortCaseLabelsOnASingleLine: false

# Tabs for indentation and alignment
UseTab: ForIndentation
TabWidth: 4
IndentWidth: 4
ContinuationIndentWidth: 4
IndentCaseLabels: false
ColumnLimit: 132

# Pointer and reference alignment
PointerAlignment: Right
ReferenceAlignment: Pointer
